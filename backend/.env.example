# WindyMail backend configuration. Copy to .env for local runs; never commit .env.
# On Render, set these in the service's Environment settings (ADR-012).

# Organization mode when set: enables the Report button (ADR-008, ADR-015).
# Leave empty for personal mode.
SOC_WEBHOOK_URL=

# Serve /docs and /openapi.json. Keep false in production.
ENABLE_API_DOCS=false
