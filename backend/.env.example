# WindyMail backend configuration. Copy to .env for local runs; never commit .env.
# On Render, set these in the service's Environment settings (ADR-012).

# Required. OAuth client ID of the Apps Script project: the expected "aud" of the
# add-on's Google ID token (ADR-011). Find it with logTokenAudience() in addon/Diagnostics.js.
GOOGLE_CLIENT_ID=

# Organization mode when set: enables the Report button (ADR-008, ADR-015).
# Must be https://. Treat it as a secret (anyone with it can post fake reports); never logged.
# Leave empty for personal mode.
SOC_WEBHOOK_URL=

# Serve /docs and /openapi.json. Keep false in production.
ENABLE_API_DOCS=false

# LLM step (ADR-019). Without a key the backend runs on its rules only and marks the
# result partial (ADR-005). Set a monthly spend limit on the key in the Anthropic Console.
ANTHROPIC_API_KEY=
# Turn the LLM step off without a deploy.
LLM_ENABLED=true
# Default claude-haiku-5-5 (ADR-016).
LLM_MODEL=

# Requests per minute per user (ADR-011); over it the backend answers 429.
RATE_LIMIT_PER_MINUTE=20
